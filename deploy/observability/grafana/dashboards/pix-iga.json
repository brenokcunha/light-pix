{
  "uid": "pix-iga",
  "title": "Pix — visão IGA",
  "description": "SLIs do Pix alinhados ao IGA: PSP × regulador, desfechos e SLOs.",
  "tags": [
    "pix",
    "iga",
    "slo"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "psp",
        "label": "PSP (ISPB)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(pix_payment_duration_seconds_count, psp_ispb)",
          "refId": "v"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Falhas injetadas",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "sum(increase(faults_injected_total[1m])) > 0",
        "step": "60s",
        "titleFormat": "Falhas injetadas",
        "textFormat": "falhas ativas nos simuladores"
      },
      {
        "name": "Reinício de container",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "changes(container_start_time_seconds{container_label_com_docker_compose_project=\"light-pix\", container_label_com_docker_compose_service!=\"\"}[1m]) > 0",
        "step": "60s",
        "titleFormat": "Reinício",
        "textFormat": "{{container_label_com_docker_compose_service}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Visão IGA.** Compara o que o PSP mede (do pedido ao estado final) com o que o regulador enxerga (instantes do SPI e relatórios dos PSPs no bacen-sim). Metas: experiência do pagador P50 ≤ 6s e P99 ≤ 10s; iniciação P50 ≤ 0,9s e P95 ≤ 1,5s; liquidação ≤ 40s. Alertas e orçamento de erro vêm dos SLOs (Sloth)."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pix finalizados/s",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pix_payments_finished_total{psp_ispb=~\"$psp\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Taxa de sucesso (5m)",
      "description": "Inclui rejeições do recebedor (AC03/AC06) e do cliente; as técnicas (AB03, ED05, AM04) estão no SLO de sucesso.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pix_payments_finished_total{psp_ispb=~\"$psp\", state=\"CONFIRMED\"}[5m])) / sum(rate(pix_payments_finished_total{psp_ispb=~\"$psp\"}[5m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
