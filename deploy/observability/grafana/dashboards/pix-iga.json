    {
      "id": 15,
      "type": "timeseries",
      "title": "Pix finalizados por estado e motivo",
      "description": "Motivos: AB03 (recebedor não respondeu no prazo), AM04 (liquidez da conta PI), ED05 (falha de liquidação), AC03/AC06 (conta do recebedor).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state, reason) (rate(pix_payments_finished_total{psp_ispb=~\"$psp\"}[$__rate_interval]))",
          "legendFormat": "{{state}} {{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
